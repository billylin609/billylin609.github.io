---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { site } from '../data/site';
import { allEntries, entrySection, href, iso, fmtLong } from '../data/entries';

// Every entry in every section, served at its directory path.
export async function getStaticPaths() {
  const items = await allEntries();
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const section = entrySection(entry);

// Two levels deep: h2 and h3 (h1 is the page title).
const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .reduce<{ slug: string; text: string; children: { slug: string; text: string }[] }[]>((acc, h) => {
    if (h.depth === 2) acc.push({ ...h, children: [] });
    else acc.at(-1)?.children.push(h);
    return acc;
  }, []);

// MathJax is ~1MB, so only pages that actually carry TeX pull it in. A bare
// `$` is not enough - prose like "~$12k ... ~$6k" would otherwise look like
// inline math - so a display block or a TeX character inside the dollars is
// what counts. `math` in the front matter overrides the guess either way.
const body = entry.body ?? '';
const hasMath =
  entry.data.math ?? (/\$\$/.test(body) || /\$[^$\n]*[\\^_{}][^$\n]*\$/.test(body));

const url = new URL(href(entry), Astro.site ?? site.url).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': entry.data.category === 'Course' ? 'ScholarlyArticle' : 'Article',
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString(),
  author: { '@type': 'Person', name: entry.data.author },
  mainEntityOfPage: url,
};
---

<Base
  title={`${entry.data.title} - ${section?.short ?? entry.data.category}`}
  description={entry.data.summary}
  type="article"
  math={hasMath}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <Section top={false} inner="px-6 pt-[72px] pb-10 max-md:px-5 max-md:pt-8 max-md:pb-6" label="Header">
    <p class="flex items-center gap-2 text-[12px] text-smoke">
      {section && <a href={`/${section.slug}`} class="hover:text-ink">{section.label}</a>}
      {section && entry.data.group && <span>/</span>}
      {entry.data.group && (
        <span class="pill bg-ink text-canvas uppercase tracking-[0.06em] !text-[10px]">{entry.data.group}</span>
      )}
    </p>
    <h1 class="mt-6 text-[clamp(32px,4.6vw,56px)] leading-[1.04] font-bold tracking-[-0.045em]">{entry.data.title}</h1>
    <p class="mt-5 text-[17px] max-md:text-[15px] leading-[1.5] text-steel max-w-[70ch]">{entry.data.summary}</p>
    <div class="mt-7 pt-[18px] border-t border-rule flex flex-wrap items-center gap-x-8 gap-y-3 text-[13px]">
      <span class="text-ink font-bold">{entry.data.author}</span>
      <time class="text-smoke" datetime={iso(entry.data.date)}>{fmtLong(entry.data.date)}</time>
      {entry.data.location && <span class="text-smoke">{entry.data.location}</span>}
      {entry.data.album && (
        <a href={entry.data.album} target="_blank" rel="noopener" class="text-steel hover:text-ink underline underline-offset-4 decoration-rule hover:decoration-ink">All photos on Drive -&gt;</a>
      )}
      <span class="ml-auto text-smoke max-md:ml-0">{entry.data.group ?? section?.label ?? entry.data.category}</span>
    </div>
  </Section>

  <Section top={false} inner="px-6 pb-24 max-md:px-5 max-md:pb-12" label="Document">
    <div class="grid grid-cols-[minmax(0,1fr)_220px] max-lg:grid-cols-1 gap-14 max-lg:gap-6">
      <article class="prose-runlog min-w-0"><Content /></article>
      {toc.length > 0 && (
        <aside class="toc max-lg:order-first lg:sticky lg:top-20 h-fit">
          <details class="lg:hidden border border-rule bg-tint">
            <summary class="flex px-4 py-3 text-[12px] font-bold text-ink">On this page<span class="ml-auto">+</span></summary>
            <ul class="px-4 pb-3 space-y-2 text-[13px]">
              {toc.map((h) => <li><a href={`#${h.slug}`} class="text-steel">{h.text}</a></li>)}
            </ul>
          </details>
          <nav class="max-lg:hidden" aria-label="On this page">
            <p class="label">On this page</p>
            <ul class="mt-3 space-y-2.5 text-[13px]">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="text-steel hover:text-ink">{h.text}</a>
                  {h.children.length > 0 && (
                    <ul class="mt-2 ml-3 space-y-2 border-l border-rule pl-3">
                      {h.children.map((c) => <li><a href={`#${c.slug}`} class="text-smoke hover:text-ink">{c.text}</a></li>)}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </Section>
</Base>
